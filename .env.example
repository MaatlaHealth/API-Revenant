# Copy to .env and fill in. Never commit .env.
# Values below are placeholders; the backend refuses to start in production with them.

# --- Backend -----------------------------------------------------------------
# development | demo | production
REVENANT_ENV=development

# SQLite locally. In production set a PostgreSQL URL (provided by the host).
DATABASE_URL=sqlite:///./revenant.db

# Exactly one worker is supported. Any other value makes the backend refuse to start.
WEB_CONCURRENCY=1

# Master key: encrypts replacement-provider credentials and keys the hashes of
# legacy-client keys. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REVENANT_SECRET_KEY=CHANGE_ME_GENERATE_A_FERNET_KEY
# Only while rotating the master key: the old value.
REVENANT_SECRET_KEY_PREVIOUS=

# Bearer token for the management API. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REVENANT_ADMIN_TOKEN=CHANGE_ME_GENERATE_A_TOKEN

# Comma-separated browser origins allowed to call the API.
REVENANT_CORS_ORIGINS=http://localhost:3000

# Outbound safety. Leave ALLOW_PRIVATE unset/false outside local demos.
REVENANT_ALLOW_PRIVATE_UPSTREAMS=false
REVENANT_UPSTREAM_ALLOWLIST=

# Mount the fictional NovaPay simulator inside the backend (hosted demo only).
REVENANT_ENABLE_DEMO_SIMULATOR=false

# Hostname routing.
# Management hosts: the only hostnames the management API answers on (comma-separated,
# no ports). Never usable as legacy hosts. Required in production.
REVENANT_PUBLIC_HOSTS=localhost,127.0.0.1
# Forwarded-host headers are ignored unless BOTH of these are set. Only enable behind a
# proxy you control that overwrites X-Forwarded-Host; list its address ranges (CIDR).
REVENANT_TRUST_FORWARDED_HOST=false
REVENANT_TRUSTED_PROXIES=

# Total lifetime of one runtime request: body upload + upstream call + response.
REVENANT_REQUEST_LIFETIME_SECONDS=30

# Instance lease (one serving process). Start-up fails unless
#   TTL  >= GRACE + REVENANT_REQUEST_LIFETIME_SECONDS + CLOCK_MARGIN
#   WAIT >= TTL + 10
REVENANT_LEASE_RENEW_SECONDS=5
REVENANT_LEASE_GRACE_SECONDS=45
REVENANT_LEASE_CLOCK_MARGIN_SECONDS=15
REVENANT_LEASE_TTL_SECONDS=90
REVENANT_LEASE_WAIT_SECONDS=120
# Development only: take the lease immediately after a hard-killed local process.
# Refused in production.
REVENANT_LEASE_FORCE_ACQUIRE=false

# Limits
REVENANT_MAX_UPLOAD_BYTES=5242880
# Upstream timeout; never longer than the time left in the request lifetime.
REVENANT_UPSTREAM_TIMEOUT_SECONDS=30

# Trace pipeline (bounded, best-effort)
REVENANT_TRACE_QUEUE_SIZE=1000
REVENANT_TRACE_DRAIN_SECONDS=5

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Demonstration (fictional credentials for the bundled simulator only) -----
DEMO_LEGACY_API_KEY=legacy-demo-key
DEMO_REPLACEMENT_TOKEN=replacement-demo-token

# --- Docker Compose only -------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
